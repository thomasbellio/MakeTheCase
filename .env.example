# Local development only. See AGENTS.md section 10.
# Copy to .env and adjust. Never commit .env.

# Matches the credentials in docker-compose.yml
DATABASE_URL=postgres://makeyourcase:makeyourcase@localhost:5432/makeyourcase

LLM_PROVIDER=anthropic            # anthropic | openai (bedrock, openai-compatible: future)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_DEFAULT=                # default model for all stages
LLM_MODEL_CLASSIFY=               # optional per-stage overrides
LLM_MODEL_EXTRACT=
LLM_MODEL_RECONSTRUCT=
MAX_DOCUMENT_CHARS=200000
PIPELINE_MAX_VALIDATION_RETRIES=3
