# Local development only. See AGENTS.md section 10.
# Copy to .env and adjust. Never commit .env.

# Matches the credentials in docker-compose.yml
DATABASE_URL=postgres://makeyourcase:makeyourcase@localhost:5432/makeyourcase

LLM_PROVIDER=anthropic            # anthropic | openai (bedrock, openai-compatible: future)
ANTHROPIC_API_KEY=                # required if any stage resolves to anthropic
OPENAI_API_KEY=                   # required if any stage resolves to openai
LLM_MODEL_DEFAULT=                # default model for all stages
LLM_MODEL_CLASSIFY=               # optional per-stage model overrides
LLM_MODEL_EXTRACT=
LLM_MODEL_RECONSTRUCT=
LLM_MODEL_JUDGE=                  # eval harness only
LLM_PROVIDER_CLASSIFY=            # optional per-stage provider overrides
LLM_PROVIDER_EXTRACT=
LLM_PROVIDER_RECONSTRUCT=
LLM_PROVIDER_JUDGE=               # eval harness only
MAX_DOCUMENT_CHARS=200000
PIPELINE_MAX_VALIDATION_RETRIES=3
GATE_MIN_ARGUMENTATIVE_SPANS=2

# `pnpm test:db` only. A separate database on the same Compose Postgres, so
# integration tests never touch development data.
TEST_DATABASE_URL=postgres://makeyourcase:makeyourcase@localhost:5432/makeyourcase_test
