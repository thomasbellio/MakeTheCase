{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Make Your Case - library (Node ESM)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024"],
    "types": ["node"],
    // Relative imports are written with the real `.ts` extension so Node can
    // execute the source directly; tsc rewrites them to `.js` on emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  }
}
