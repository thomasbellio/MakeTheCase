{
  "name": "@make-your-case/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke:structured": "node --env-file-if-exists=../../.env scripts/smoke-structured.ts",
    "try:stages": "node --env-file-if-exists=../../.env scripts/try-stages.ts",
    "test:db": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.16",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.6.2",
    "@make-your-case/analysis": "workspace:*",
    "@make-your-case/domain": "workspace:*",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@make-your-case/config": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
