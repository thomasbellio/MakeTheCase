{
  "extends": "@make-your-case/config/tsconfig/library.json",
  "compilerOptions": {
    // No rootDir/outDir: library packages are consumed as TypeScript source
    // and have no build step (AGENTS.md section 5.4), so tests can be
    // typechecked alongside src.
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["src/**/__boundaries__/**"]
}
